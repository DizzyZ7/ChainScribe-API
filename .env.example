# Local development values only. Generate independent secrets for production.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=development-only-django-key-never-use-this-in-production
JWT_SIGNING_KEY=development-only-jwt-key-never-use-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=chainscribe
POSTGRES_USER=chainscribe
POSTGRES_PASSWORD=chainscribe-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0

API_TOKEN_TTL_DAYS=30
API_TOKEN_TOUCH_MINUTES=5
JWT_ACCESS_MINUTES=5
JWT_REFRESH_HOURS=24
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_WRITE_REQUESTS=60
LOG_LEVEL=INFO
